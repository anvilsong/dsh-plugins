{
  "name": "dsh-plugin-session-search-patched",
  "version": "0.0.0-spike.1",
  "private": true,
  "description": "S1 spike probe only: same package name, row id and bundle patch as the real package, with a probe in place of the patched engine. Never installed outside a scratch DSH home.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "engines": { "dsh": "0.2.2-rc.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.2-rc.3"
  },
  "license": "MIT"
}
