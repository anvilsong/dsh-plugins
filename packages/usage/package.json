{
  "name": "dsh-plugin-provider-usage",
  "description": "Provider usage for DSH — OpenRouter credits, Kimi Code quota, DeepSeek balance, GLM and MiniMax coding-plan windows, NewAPI quota, OpenAI Codex and Claude plan quota; composer chips gated on the active provider; /usage-* report commands; /provider-login OAuth sign-in",
  "version": "0.7.0",
  "type": "module",
  "main": "src/index.host.js",
  "meta": {
    "title": "Provider usage",
    "description": "OpenRouter, Kimi Code, DeepSeek, GLM, MiniMax, NewAPI, OpenAI Codex and Claude usage on Settings → Models, in composer chips, and through /usage-* commands, with OAuth sign-in for Codex and Claude"
  },
  "exports": {
    ".": {
      "default": "./src/index.host.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "files": [
    "src/index.host.js",
    "src/providers",
    "src/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "anvilsong",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvilsong/dsh-plugins.git",
    "directory": "packages/usage"
  },
  "homepage": "https://github.com/anvilsong/dsh-plugins/tree/main/packages/usage#readme",
  "bugs": "https://github.com/anvilsong/dsh-plugins/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "usage",
    "quota",
    "openrouter",
    "kimi",
    "glm",
    "minimax",
    "deepseek",
    "newapi"
  ]
}
