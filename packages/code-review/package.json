  },
  "homepage": "https://github.com/anvilsong/dsh-plugins/tree/main/packages/code-review#readme",
  "bugs": "https://github.com/anvilsong/dsh-plugins/issues",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "code-review", "review"]
}
