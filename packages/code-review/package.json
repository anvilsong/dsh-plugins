    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "Code review",
    "description": "Run a bounded review of a workspace, file, or patch."
  },
  "exports": {
    ".": {
      "default": "./src/index.host.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "anvilsong",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvilsong/dsh-plugins.git",
