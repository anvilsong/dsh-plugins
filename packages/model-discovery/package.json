{
  "name": "dsh-plugin-model-discovery",
  "version": "0.1.0",
  "description": "Append models from the latest pi-ai catalog to llm-pi-ai providers that already list their models explicitly.",
  "type": "module",
  "main": "src/index.host.js",
  "meta": {
    "title": "Model discovery",
    "description": "Append new pi-ai catalog models to providers that list their models explicitly."
  },
  "exports": {
    ".": {
      "default": "./src/index.host.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "anvilsong",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvilsong/dsh-plugins.git",
    "directory": "packages/model-discovery"
  },
  "homepage": "https://github.com/anvilsong/dsh-plugins/tree/main/packages/model-discovery#readme",
  "bugs": "https://github.com/anvilsong/dsh-plugins/issues",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "models", "pi-ai", "catalog"]
}
