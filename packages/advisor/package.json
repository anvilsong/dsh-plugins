{
  "name": "dsh-plugin-advisor",
  "version": "0.5.0",
  "description": "Opt-in in-process advisor (plans and design/review advice) with read-only evidence verification.",
  "type": "module",
  "main": "src/index.host.js",
  "files": [
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "Advisor",
    "description": "Toggle the in-process advisor and read-only verification, and choose their models, for this session."
  },
  "exports": {
    ".": {
      "default": "./src/index.host.js"
    },
    "./client": {
      "default": "./src/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-executor-native": "*",
    "@deepseek-ai/dsh-tool-subagent": "*",
    "@deepseek-ai/dsh-tool-subagent-control": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tool-executor-native": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-subagent-control": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "anvilsong",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvilsong/dsh-plugins.git",
    "directory": "packages/advisor"
  },
  "homepage": "https://github.com/anvilsong/dsh-plugins/tree/main/packages/advisor#readme",
  "bugs": "https://github.com/anvilsong/dsh-plugins/issues",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "advisor", "subagent", "review", "planning"]
}
